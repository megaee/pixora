{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make setup)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make format)",
      "Bash(make build)",
      "Bash(make check)",
      "Bash(cd backend && .venv/bin/pytest:*)",
      "Bash(cd backend && .venv/bin/ruff:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run format:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(rm -rf ~*)",
      "Bash(rm -rf /*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
